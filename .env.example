# Copy this file to .env and update the values below

# Application Settings
APP_NAME=KalingaLink
APP_KEY=
APP_ENV=development

# Database Configuration
DB_HOST=your_aiven_host
DB_PORT=your_aiven_port
DB_USER=your_aiven_username
DB_PASSWORD=your_aiven_password
DB_NAME=kalingalink
DB_SSL_CA=C:\path\to\your\aiven-ca.pem

# Token secrets: replace with unique random values
JWT_SECRET=replace-with-a-long-random-secret
REFRESH_TOKEN_KEY=replace-with-another-long-random-secret

# Google OAuth web client credentials (keep the client secret server-side).
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URI=http://127.0.0.1:8000/api/auth/google/callback
GOOGLE_OAUTH_FRONTEND_URL=http://127.0.0.1:5173/login

# Public frontend URL used to build teacher invitation links (HTTPS outside local development).
APP_BASE_URL=http://127.0.0.1:5173

# Brevo SMTP (use the SMTP key, not an API key).
MAIL_HOST=smtp-relay.brevo.com
MAIL_PORT=587
MAIL_ENCRYPTION=tls
# Brevo SMTP login email address.
MAIL_USERNAME=
# Brevo SMTP key. Never use or commit your account password.
MAIL_PASSWORD=
# Must be a verified sender in Brevo.
MAIL_FROM_ADDRESS=
MAIL_FROM_NAME=KalingaLink Administration

# Comma-separated browser origins allowed to call the backend.
API_ALLOWED_ORIGINS=http://localhost:5173,https://your-frontend.example.com

# Set REFRESH_COOKIE_SAMESITE=None only for cross-site frontend/backend hosts.
# SameSite=None requires secure cookies and HTTPS.
REFRESH_COOKIE_SAMESITE=Lax
# Leave blank to default to Secure in production and non-Secure in development.
# Set to 1 explicitly for HTTPS deployments behind a TLS-terminating proxy.
REFRESH_COOKIE_SECURE=

# Migrations are disabled by default; enable only while applying migrations.
MIGRATIONS_ENABLED=0

# Development-only seed password; generate a strong local value
DEMO_SEED_PASSWORD=replace-with-a-random-strong-password
DEMO_ADMIN_EMAIL=admin@kalingalink.local
